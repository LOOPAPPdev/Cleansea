            89.94,
            64.9
          ]
        },
        "dark": {
          "base": [
            192,
            10,
            10.39
          ],
          "accent": [
            249.2,
            100,
            73.14
          ]
        }
      },
      "lavender": {
        "label": "Lavanda",
        "light": {
          "base": [
            250,
            14,
            94.9
          ],
          "accent": [
            250.06,
            89.94,
            64.9
          ]
        },
        "dark": {
          "base": [
            250,
            12,
            10.39
          ],
          "accent": [
            249.2,
            100,
            73.14
          ]
        }
      }
    }
  },
  "obsidian": {
    "method": "Obsidian variable vocabulary as defined by the vendored Minimal theme (vendor/obsidian-minimal, MIT). Colours map to foundation layers; measures come from Minimal (minimal.json); heading sizes use the Loop modular scale; values Obsidian keeps in its closed base CSS use Loop values.",
    "scope": ".markdown-rendered",
    "vars": {
      "--background-primary": "{layer.bg1}",
      "--background-primary-alt": "{layer.bg2}",
      "--background-secondary": "{layer.bg2}",
      "--background-modifier-hover": "{layer.bg3}",
      "--background-table-rows": "{layer.bg2}",
      "--background-modifier-border": "{layer.ui1}",
      "--background-modifier-border-hover": "{layer.ui2}",
      "--background-modifier-border-focus": "{layer.ui3}",
      "--text-normal": "{layer.tx1}",
      "--text-muted": "{layer.tx2}",
      "--text-faint": "{layer.tx3}",
      "--text-code": "{layer.tx4}",
      "--text-accent": "{layer.ax1}",
      "--text-accent-hover": "{layer.ax2}",
      "--interactive-accent": "{layer.ax3}",
      "--text-selection": "{layer.hl1}",
      "--text-highlight-bg": "{semantic.warning}",
      "--code-background": "{layer.bg2}",
      "--blockquote-color": "{layer.tx2}",
      "--blockquote-border-color": "{layer.ui2}",
      "--list-marker-color": "{layer.tx3}",
      "--checkbox-color": "{layer.tx1}",
      "--checkbox-border-color": "{layer.ui3}",
      "--checklist-done-color": "{layer.tx2}",
      "--tag-color": "{layer.tx2}",
      "--tag-color-hover": "{layer.tx1}",
      "--tag-border-color": "{layer.ui1}",
      "--tag-border-color-hover": "{layer.ui2}",
      "--hr-color": "{layer.ui1}",
      "--table-border-color": "{layer.ui1}",
      "--line-width": "{minimal.--line-width}",
      "--line-height": "{minimal.--line-height}",
      "--p-spacing": "{minimal.--p-spacing}",
      "--heading-spacing": "{minimal.--heading-spacing}",
      "--list-indent": "{minimal.--list-indent}",
      "--list-spacing": "{minimal.--list-spacing}",
      "--nested-padding": "{minimal.--nested-padding}",
      "--border-width": "{minimal.--border-width}",
      "--table-border-width": "{minimal.--table-border-width}",
      "--blockquote-border-thickness": "{minimal.--blockquote-border-thickness}",
      "--blockquote-style": "{minimal.--blockquote-style}",
      "--tag-size": "{minimal.--tag-size}",
      "--tag-padding-y": "{minimal.--tag-padding-y}",
      "--tag-border-width": "{minimal.--tag-border-width}",
      "--checkbox-radius": "{minimal.--checkbox-radius}",
      "--image-radius": "{minimal.--image-radius}",
      "--checklist-done-decoration": "{minimal.--checklist-done-decoration}",
      "--h1-weight": "{minimal.--h1-weight}",
      "--h2-weight": "{minimal.--h2-weight}",
      "--h3-weight": "{minimal.--h3-weight}",
      "--h4-weight": "{minimal.--h4-weight}",
      "--h5-weight": "{minimal.--h5-weight}",
      "--h6-weight": "{minimal.--h6-weight}",
      "--h5-variant": "{minimal.--h5-variant}",
      "--h6-variant": "{minimal.--h6-variant}",
      "--h1-size": "{type.3}",
      "--h2-size": "{type.2}",
      "--h3-size": "{type.1}",
      "--h4-size": "{type.0}",
      "--h5-size": "{type.0}",
      "--h6-size": "{type.0}",
      "--tag-padding-x": "0.65em",
      "--tag-radius": "{scale.radius.pill}",
      "--code-radius": "{scale.radius.sm}",
      "--callout-radius": "{scale.radius.md}",
      "--callout-padding": "0.75rem 1rem",
      "--font-monospace": "{scale.family.mono}",
      "--checkbox-size": "1em"
    }
  },
  "semantic": {
    "background": {
      "share": "60%",
      "light": "{layer.bg1}",
      "dark": "{layer.bg1}",
      "usage": "Page and panel ground (white)."
    },
    "surface": {
      "share": "20%",
      "light": "{layer.bg2}",
      "dark": "{layer.bg2}",
      "usage": "Gray ground that holds groups, cards, bands, footer."
    },
    "surface-raised": {
      "light": "{layer.raised}",
      "dark": "{layer.raised}",
      "usage": "White nodes/cards placed on surface or on a tint; menus."
    },
    "surface-sunken": {
      "light": "{layer.bg3}",
      "dark": "{layer.bg3}",
      "usage": "Selected pill of a segmented control; hover on surface."
    },
    "foreground": {
      "share": "10%",
      "light": "{layer.tx1}",
      "dark": "{layer.tx1}",
      "usage": "Titles, body text, node labels."
    },
    "muted-foreground": {
      "light": "{layer.tx2}",
      "dark": "{layer.tx2}",
      "usage": "Descriptions, eyebrows, icons."
    },
    "subtle-foreground": {
      "light": "{layer.tx3}",
      "dark": "{layer.tx3}",
      "usage": "Unselected tabs, tertiary text (AA-safe version of the reference #878787)."
    },
    "border": {
      "light": "#00000014",
      "dark": "#FFFFFF14",
      "usage": "Panel and card edges, dividers."
    },
    "border-strong": {
      "light": "{layer.ui3}",
      "dark": "{layer.ui3}",
      "usage": "Form control borders (≥ 3:1)."
    },
    "tint-sage": {
      "share": "5%",
      "light": "{sage.100}",
      "dark": "{sage.800}",
      "usage": "Group ground: interface / front-end layer."
    },
    "tint-sage-border": {
      "light": "{sage.400}",
      "dark": "{sage.600}",
      "usage": "Border of a sage group (decorative; the heading carries the meaning)."
    },
    "tint-lavender": {
      "share": "5%",
      "light": "{lavender.100}",
      "dark": "{lavender.800}",
      "usage": "Group ground: backend / domain layer; highlighted plan."
    },
    "tint-lavender-border": {
      "light": "{lavender.400}",
      "dark": "{lavender.600}",
      "usage": "Border of a lavender group."
    },
    "primary": {
      "light": "{layer.tx1}",
      "dark": "{layer.tx1}",
      "usage": "Primary button fill (black)."
    },
    "primary-hover": {
      "light": "{layer.tx4}",
      "dark": "{layer.tx4}",
      "usage": "Hover of the primary fill."
    },
    "primary-foreground": {
      "light": "{white.50}",
      "dark": "{layer.bg1}",
      "usage": "Text on the primary fill."
    },
    "primary-strong": {
      "light": "{layer.ax1}",
      "dark": "{layer.ax1}",
      "usage": "Inline link text (brand purple, AA-safe)."
    },
    "primary-strong-hover": {
      "light": "{layer.ax2}",
      "dark": "{layer.ax2}",
      "usage": "Hover of inline link text."
    },
    "brand": {
      "light": "{layer.ax3}",
      "dark": "{layer.ax3}",
      "usage": "Brand purple #7055F6: focus ring and brand marks only."
    },
    "success": {
      "light": "{green.300}",
      "dark": "{green.300}",
      "usage": "Success status fill only."
    },
    "success-foreground": {
      "light": "{layer.tx1}",
      "dark": "{layer.bg1}",
      "usage": "Text on success fill."
    },
    "success-strong": {
      "light": "{green.700}",
      "dark": "{green.400}",
      "usage": "Success icon/border/text."
    },
    "warning": {
      "light": "{warm.100}",
      "dark": "{warm.900}",
      "usage": "Status badge fill (Proposta / Protótipo)."
    },
    "warning-foreground": {
      "light": "{warm.800}",
      "dark": "{warm.200}",
      "usage": "Text on warning fill."
    },
    "destructive": {
      "light": "{red.700}",
      "dark": "{red.400}",
      "usage": "Errors."
    },
    "ring": {
      "light": "{layer.ax3}",
      "dark": "{layer.ax3}",
      "usage": "Focus ring (brand purple, ≥ 3:1)."
    },
    "selection": {
      "light": "{layer.hl1}",
      "dark": "{layer.hl1}",
      "usage": "Text selection highlight (accent at 25 %)."
    },
    "chart-1": {
      "light": "{lavender.700}",
      "dark": "{lavender.200}",
      "usage": "Data series 1: order alternates dark/light so neighbours differ in lightness, not only hue (≥ 3:1 vs background)."
    },
    "chart-2": {
      "light": "{sage.500}",
      "dark": "{sage.400}",
      "usage": "Data series 2: order alternates dark/light so neighbours differ in lightness, not only hue (≥ 3:1 vs background)."
    },
    "chart-3": {
      "light": "{warm.600}",
      "dark": "{warm.300}",
      "usage": "Data series 3: order alternates dark/light so neighbours differ in lightness, not only hue (≥ 3:1 vs background)."
    },
    "chart-4": {
      "light": "{neutral.700}",
      "dark": "{neutral.300}",
      "usage": "Data series 4: order alternates dark/light so neighbours differ in lightness, not only hue (≥ 3:1 vs background)."
    },
    "chart-5": {
      "light": "{lavender.500}",
      "dark": "{lavender.400}",
      "usage": "Data series 5: order alternates dark/light so neighbours differ in lightness, not only hue (≥ 3:1 vs background)."
    },
    "chart-6": {
      "light": "{sage.700}",
      "dark": "{sage.200}",
      "usage": "Data series 6: order alternates dark/light so neighbours differ in lightness, not only hue (≥ 3:1 vs background)."
    },
    "chart-grid": {
      "light": "{layer.ui1}",
      "dark": "{layer.ui1}",
      "usage": "Chart grid lines (decorative)."
    },
    "chart-axis": {
      "light": "{layer.tx3}",
      "dark": "{layer.tx3}",
      "usage": "Axis labels and ticks (text, ≥ 4.5:1)."
    }
  },
