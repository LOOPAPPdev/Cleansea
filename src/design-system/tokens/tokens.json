  "scale": {
    "radius": {
      "sm": "8px",
      "md": "12px",
      "lg": "16px",
      "xl": "24px",
      "pill": "999px"
    },
    "space": {
      "section": "clamp(56px, 8vw, 112px)",
      "gutter": "max(16px, 4vw)",
      "container": "1280px",
      "measure": "720px"
    },
    "target": {
      "min": "44px"
    },
    "family": {
      "sans": "var(--font-inter), -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", Arial, sans-serif",
      "mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
    },
    "motion": {
      "fast": "160ms",
      "base": "240ms",
      "ease": "cubic-bezier(0.25, 0.1, 0.25, 1)"
    },
    "header": {
      "height": "72px"
    },
    "icon": {
      "sm": "16px",
      "md": "20px",
      "lg": "24px"
    },
    "stroke": {
      "thin": "1.5",
      "regular": "2"
    },
    "grid": {
      "unit": "8px"
    },
    "reading": {
      "width": "{minimal.--line-width}",
      "line-height": "{minimal.--line-height}",
      "p-spacing": "{minimal.--p-spacing}",
      "heading-spacing": "{minimal.--heading-spacing}",
      "list-indent": "{minimal.--list-indent}",
      "rule": "{minimal.--blockquote-border-thickness}"
    }
  },
