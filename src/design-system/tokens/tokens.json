  "typography": {
    "family": "Inter",
    "base": "16px",
    "ratio": "2^(1/5) — size doubles every 5 steps",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "steps": {
      "m2": {
        "size": "0.7579rem",
        "px": 12.1,
        "lineHeight": "1.6",
        "tracking": "0em"
      },
      "m1": {
