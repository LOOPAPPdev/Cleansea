{
  "$schema": "./tokens.schema.json",
  "name": "Loop Consultoria",
  "version": "3.0.0",
  "rule": "neutral-first: white 60 · gray 20 · black 10 · lavender/sage tints 10",
  "primitives": {
    "white": { "50": "#FFFFFF", "75": "#FCFCFC", "100": "#F3F3F7" },
    "neutral": { "100": "#F2F2F2", "150": "#EEEEEE", "200": "#E8E8E8", "400": "#8A8A8A", "500": "#6B6B6B", "600": "#505050", "900": "#000000", "950": "#0F0F10" },
    "gray": { "100": "#EEECF9" },
    "black": { "900": "#2C293D" },
    "sage": { "100": "#E3E7E8", "400": "#ABB6B8", "800": "#1E2426", "600": "#4F5D60" },
    "lavender": { "100": "#E6E5EB", "400": "#AEADBF", "800": "#221F2A", "600": "#57546B" },
    "purple": { "300": "#A797FF", "400": "#8B76FF", "500": "#7055F6", "600": "#5A44C5" },
    "green": { "300": "#BEFBB6", "400": "#7EE08A", "700": "#1F6B2A" },
    "peach": { "100": "#F9E5DA", "800": "#673729", "900": "#3A2116", "300": "#FFB38A" },
    "red": { "400": "#FF6B6B", "700": "#C4001A" },
    "night": { "100": "#1A1A1B", "200": "#222224", "300": "#2A2A2C", "400": "#D4D4D4", "500": "#6E6E73", "600": "#A3A3A3", "50": "#F5F5F5" }
  },
  "semantic": {
    "background":          { "share": "60%", "light": "{white.75}",     "dark": "{neutral.950}", "usage": "Page and panel ground (white)." },
    "surface":             { "share": "20%", "light": "{neutral.100}",  "dark": "{night.100}",   "usage": "Gray ground that holds groups, cards, bands, footer." },
    "surface-raised":      { "light": "{white.50}",     "dark": "{night.200}",   "usage": "White nodes/cards placed on surface or on a tint; menus." },
    "surface-sunken":      { "light": "{neutral.150}",  "dark": "{night.300}",   "usage": "Selected pill of a segmented control; hover on surface." },
    "foreground":          { "share": "10%", "light": "{neutral.900}",  "dark": "{night.50}",    "usage": "Titles, body text, node labels." },
    "muted-foreground":    { "light": "{neutral.600}",  "dark": "{night.600}",   "usage": "Descriptions, eyebrows, icons." },
    "subtle-foreground":   { "light": "{neutral.500}",  "dark": "{night.600}",   "usage": "Unselected tabs, tertiary text (AA-safe version of the reference #878787)." },
    "border":              { "light": "#00000014",      "dark": "#FFFFFF14",     "usage": "Panel and card edges, dividers." },
    "border-strong":       { "light": "{neutral.400}",  "dark": "{night.500}",   "usage": "Form control borders (≥ 3:1)." },
    "tint-sage":           { "share": "5%", "light": "{sage.100}", "dark": "{sage.800}", "usage": "Group ground: interface / front-end layer." },
    "tint-sage-border":    { "light": "{sage.400}",     "dark": "{sage.600}",    "usage": "Border of a sage group (decorative; the heading carries the meaning)." },
    "tint-lavender":       { "share": "5%", "light": "{lavender.100}", "dark": "{lavender.800}", "usage": "Group ground: backend / domain layer; highlighted plan." },
    "tint-lavender-border":{ "light": "{lavender.400}", "dark": "{lavender.600}", "usage": "Border of a lavender group." },
    "primary":             { "light": "{neutral.900}",  "dark": "{night.50}",    "usage": "Primary button fill (black)." },
    "primary-hover":       { "light": "#333333",        "dark": "{night.400}",   "usage": "Hover of the primary fill." },
    "primary-foreground":  { "light": "{white.50}",     "dark": "{neutral.950}", "usage": "Text on the primary fill." },
    "primary-strong":      { "light": "{purple.600}",   "dark": "{purple.300}",  "usage": "Inline link text (brand purple, AA-safe)." },
    "brand":               { "light": "{purple.500}",   "dark": "{purple.400}",  "usage": "Brand purple #7055F6: focus ring and brand marks only." },
    "success":             { "light": "{green.300}",    "dark": "{green.300}",   "usage": "Success status fill only." },
    "success-foreground":  { "light": "{neutral.900}",  "dark": "{neutral.950}", "usage": "Text on success fill." },
    "success-strong":      { "light": "{green.700}",    "dark": "{green.400}",   "usage": "Success icon/border/text." },
    "warning":             { "light": "{peach.100}",    "dark": "{peach.900}",   "usage": "Status badge fill (Proposta / Protótipo)." },
    "warning-foreground":  { "light": "{peach.800}",    "dark": "{peach.300}",   "usage": "Text on warning fill." },
    "destructive":         { "light": "{red.700}",      "dark": "{red.400}",     "usage": "Errors." },
    "ring":                { "light": "{purple.500}",   "dark": "{purple.400}",  "usage": "Focus ring (brand purple, ≥ 3:1)." }
  },
  "contrast": [
    ["foreground", "background", 4.5], ["foreground", "surface", 4.5], ["foreground", "surface-raised", 4.5],
    ["foreground", "tint-sage", 4.5], ["foreground", "tint-lavender", 4.5],
    ["muted-foreground", "background", 4.5], ["muted-foreground", "surface", 4.5], ["muted-foreground", "tint-lavender", 4.5], ["muted-foreground", "tint-sage", 4.5],
    ["subtle-foreground", "background", 4.5], ["subtle-foreground", "surface", 4.5],
    ["primary-foreground", "primary", 4.5], ["primary-foreground", "primary-hover", 4.5],
    ["primary-strong", "background", 4.5], ["primary-strong", "surface", 4.5],
    ["success-foreground", "success", 4.5], ["success-strong", "background", 3],
    ["warning-foreground", "warning", 4.5], ["destructive", "background", 4.5],
    ["border-strong", "background", 3], ["ring", "background", 3], ["ring", "surface", 3]
  ],
  "scale": {
    "radius": { "sm": "8px", "md": "12px", "lg": "16px", "xl": "24px", "pill": "999px" },
    "space": { "section": "clamp(56px, 8vw, 112px)", "gutter": "max(16px, 4vw)", "container": "1280px", "measure": "720px" },
    "target": { "min": "44px" },
    "family": { "sans": "var(--font-inter), -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", Arial, sans-serif", "mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace" },
    "motion": { "fast": "160ms", "base": "240ms", "ease": "cubic-bezier(0.25, 0.1, 0.25, 1)" },
    "header": { "height": "72px" }
  }
}
