  "foundation": {
    "method": "Minimal theme for Obsidian (Steph Ango, MIT): one base colour and one accent colour in HSL drive every background, line, text and accent layer. A scheme changes only base/accent; layers keep their offsets [Δs, Δl]. Structure adopted; values are Loop's.",
    "default": "neutral",
    "layers": {
      "raised": {
        "usage": "Raised node or menu on a ground (white).",
        "from": "base",
        "light": [
          0,
          5.1
        ],
        "dark": [
          1,
          3.3
        ]
      },
      "bg1": {
        "usage": "Primary background: page and panels.",
        "from": "base",
        "light": [
          0,
          3.9
        ],
        "dark": [
          1.3,
          -4.3
        ]
      },
      "bg2": {
        "usage": "Secondary background: grounds, bands, footer (the base colour itself).",
        "from": "base",
        "light": [
          0,
          0
        ],
        "dark": [
          0,
          0
        ]
      },
      "bg3": {
        "usage": "Hover and selected ground.",
        "from": "base",
        "light": [
          0,
          -1.6
        ],
        "dark": [
          0.4,
          6.5
        ]
      },
      "ui1": {
        "usage": "Faint line: chart grid, dividers on grounds.",
        "from": "base",
        "light": [
          0,
          -3.9
        ],
        "dark": [
          0.4,
          6.5
        ]
      },
      "ui2": {
        "usage": "Hover line: quote rule, table rule.",
        "from": "base",
        "light": [
          0,
          -22.4
        ],
        "dark": [
          0.9,
          17.8
        ]
      },
      "ui3": {
        "usage": "Strong line: form controls (≥ 3:1).",
        "from": "base",
        "light": [
          0,
          -40.8
        ],
        "dark": [
          0.3,
          33.7
        ]
      },
      "tx1": {
        "usage": "Normal text and primary fill.",
        "from": "base",
        "light": [
          0,
          -94.9
        ],
        "dark": [
          -6,
          85.7
        ]
      },
      "tx2": {
        "usage": "Muted text: descriptions, icons.",
        "from": "base",
        "light": [
          -6,
          -63.5
        ],
        "dark": [
          -6,
          53.5
        ]
      },
      "tx3": {
        "usage": "Faint text: tertiary labels, axis (still ≥ 4.5:1, unlike Minimal's decorative faint).",
        "from": "base",
        "light": [
          -6,
          -52.9
        ],
        "dark": [
          -6,
          53.5
        ]
      },
      "tx4": {
        "usage": "Strong secondary: hover of the primary fill.",
        "from": "base",
        "light": [
          -6,
          -74.9
        ],
        "dark": [
          -6,
          72.7
        ]
      },
      "ax1": {
        "usage": "Accent text: inline links.",
        "from": "accent",
        "light": [
          -37.3,
          -12.9
        ],
        "dark": [
          0,
          6.5
        ]
      },
      "ax2": {
        "usage": "Accent hover: link hover.",
        "from": "accent",
        "light": [
          -37.3,
          -20.9
        ],
        "dark": [
          0,
          13
        ]
      },
      "ax3": {
        "usage": "Accent mark: focus ring and brand mark (the accent colour itself).",
        "from": "accent",
        "light": [
          0,
          0
        ],
        "dark": [
          0,
          0
        ]
      },
      "hl1": {
        "usage": "Text selection (accent at 25 %).",
        "from": "accent",
        "light": [
          0,
          0
        ],
        "dark": [
          0,
          0
        ],
        "alpha": "40"
      }
    },
    "schemes": {
      "neutral": {
        "label": "Neutro (padrão)",
        "light": {
          "base": [
            0,
            0,
            94.9
          ],
