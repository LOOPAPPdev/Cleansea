{
  "$schema": "./tokens.schema.json",
  "name": "Loop Consultoria",
  "version": "2.0.0",
  "rule": "60-20-10-5-5",
  "primitives": {
    "white": { "50": "#FFFFFF", "100": "#F3F3F7" },
    "gray": { "100": "#EEECF9", "200": "#E2DFF2", "500": "#7A7690", "600": "#5E5A72" },
    "black": { "900": "#2C293D", "950": "#15131F" },
    "purple": { "300": "#A797FF", "400": "#8B76FF", "500": "#7055F6", "600": "#5A44C5", "700": "#4A37A6" },
    "green": { "300": "#BEFBB6", "400": "#7EE08A", "700": "#1F6B2A" },
    "orange": { "100": "#FDE8DC", "700": "#9A4A12", "900": "#3A2116", "300": "#FFB38A" },
    "red": { "400": "#FF6B6B", "700": "#C4001A" },
    "night": { "100": "#1E1B2E", "200": "#2A2640", "500": "#77738E", "600": "#A9A5BC" }
  },
  "semantic": {
    "background":          { "share": "60%", "light": "{white.100}",  "dark": "{black.950}",  "usage": "Page ground and large reading areas." },
    "surface":             { "share": "20%", "light": "{gray.100}",   "dark": "{night.100}",  "usage": "Cards, navigation, panels, containers." },
    "surface-raised":      { "light": "{white.50}",  "dark": "{night.200}", "usage": "Popovers, menus, cards placed on surface." },
    "surface-sunken":      { "light": "{gray.200}",  "dark": "{night.200}", "usage": "Hover on surface, inset wells." },
    "foreground":          { "share": "10%", "light": "{black.900}",  "dark": "{white.100}",  "usage": "Body text, headings, strong borders." },
    "muted-foreground":    { "light": "{gray.600}",  "dark": "{night.600}", "usage": "Secondary text, metadata, captions." },
    "border":              { "light": "#2C293D1F",    "dark": "#F3F3F71F",  "usage": "Decorative dividers and card edges (surface vs background is only 1.05:1)." },
    "border-strong":       { "light": "{gray.500}",  "dark": "{night.500}", "usage": "Control borders (inputs, checkboxes); ≥ 3:1." },
    "primary":             { "share": "5%", "light": "{purple.500}", "dark": "{purple.400}", "usage": "Primary buttons, brand fills. Never as small text in light." },
    "primary-hover":       { "light": "{purple.600}", "dark": "{purple.300}", "usage": "Hover/active of primary fills." },
    "primary-foreground":  { "light": "{white.50}",  "dark": "{black.950}", "usage": "Text on primary fills." },
    "primary-strong":      { "light": "{purple.600}", "dark": "{purple.300}", "usage": "Purple TEXT: links, active nav, inline emphasis (AA on background and surface)." },
    "success":             { "share": "5%", "light": "{green.300}", "dark": "{green.300}", "usage": "Success fills: badges, positive alerts. Always with success-foreground text." },
    "success-foreground":  { "light": "{black.900}", "dark": "{black.950}", "usage": "Text on success fills." },
    "success-strong":      { "light": "{green.700}", "dark": "{green.400}", "usage": "Success icons, borders, text on background." },
    "warning":             { "light": "{orange.100}", "dark": "{orange.900}", "usage": "Status fill (Protótipo / Proposta)." },
    "warning-foreground":  { "light": "{orange.700}", "dark": "{orange.300}", "usage": "Text on warning fill." },
    "destructive":         { "light": "{red.700}",   "dark": "{red.400}",   "usage": "Errors and destructive actions." },
    "ring":                { "light": "{purple.600}", "dark": "{purple.300}", "usage": "Focus ring (≥ 3:1)." }
  },
  "contrast": [
    ["foreground", "background", 4.5], ["foreground", "surface", 4.5], ["foreground", "surface-raised", 4.5],
    ["muted-foreground", "background", 4.5], ["muted-foreground", "surface", 4.5],
    ["primary-foreground", "primary", 4.5], ["primary-foreground", "primary-hover", 4.5],
    ["primary-strong", "background", 4.5], ["primary-strong", "surface", 4.5],
    ["success-foreground", "success", 4.5], ["success-strong", "background", 3],
    ["warning-foreground", "warning", 4.5], ["destructive", "background", 4.5],
    ["border-strong", "background", 3], ["ring", "background", 3]
  ],
  "scale": {
    "radius": { "sm": "8px", "md": "12px", "lg": "16px", "xl": "24px", "pill": "999px" },
    "space": { "section": "clamp(56px, 8vw, 112px)", "gutter": "max(16px, 4vw)", "container": "1280px", "measure": "720px" },
    "target": { "min": "44px" },
    "family": { "sans": "var(--font-inter), -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", Arial, sans-serif", "mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace" },
    "motion": { "fast": "160ms", "base": "240ms", "ease": "cubic-bezier(0.25, 0.1, 0.25, 1)" },
    "header": { "height": "72px" }
  }
}
