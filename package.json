{
	"name": "loop-cleansea",
	"description": "Loop Consultoria — site e design system (Next.js on Cloudflare Workers).",
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@hookform/resolvers": "^7.0.5",
		"@opennextjs/cloudflare": "1.14.0",
		"@tailwindcss/postcss": "^4.3.5",
		"@tanstack/react-query": "^5.107.1",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.2",
		"lucide-react": "^1.72.0",
		"motion": "^14.12.0",
		"next": "16.0.11",
		"react": "19.2.1",
		"react-dom": "19.2.1",
		"react-hook-form": "^7.92.0",
		"shadcn": "^4.23.0",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@types/node": "24.10.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"eslint": "9.39.2",
		"eslint-config-next": "16.0.11",
		"typescript": "5.9.3",
		"wrangler": "4.136.1"
	},
	"private": true,
	"scripts": {
		"build": "next build",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv env.d.ts",
		"check": "npm run build && tsc",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"dev": "next dev",
		"lint": "eslint .",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"start": "next start",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"tokens": "node scripts/tokens.mjs",
		"contrast": "node scripts/tokens.mjs --check"
	}
}
